# ─── Supabase (free at supabase.com) ─────────────────────────
# Project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── YouTube Data API v3 ──────────────────────────────────────
# 1. Go to console.cloud.google.com
# 2. Create a project → Enable "YouTube Data API v3"
# 3. Credentials → Create API Key → restrict to YouTube Data API
# Channel is auto-resolved from handle @idimensionpodcast — no Channel ID needed
EXPO_PUBLIC_YOUTUBE_API_KEY=

# ─── Shopify Storefront API ───────────────────────────────────
# 1. Shopify Admin → Settings → Apps and sales channels → Develop apps
# 2. Create app → Configure Storefront API → grant read_products scope
# 3. Install app → copy the Storefront API access token
EXPO_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
